PKGNAME r2flutter
VERSION 0.2.0
CONTACT pancake ; pancake@nopcode.org

LANG_C!

EXEC! R2_VERSION r2 -v ;
EXEC! R2_CFLAGS r2 -H R2_CFLAGS ;
EXEC! R2_LDFLAGS r2 -H R2_LDFLAGS ;
EXEC! R2_LIBS r2 -H R2_LIBS ;

ARG_WITH PRECOMPILED_AGENT precompiled-agent do not require node/npm ;

REPORT R2_VERSION ;

SUBDIRS ./config.mk ;
