NAME=r2script-method-order
FILE=bins/ios/Runner.app/Frameworks/App.framework/App
CMDS=<<CMDS_END
L ../src/r2/core_flutter.dylib
L ../src/r2/core_flutter.so
r2flutter -R~^f method.:0..3
CMDS_END
EXPECT=<<EXPECT_END
f method.PointerEvent.get:radiusMinor = 0xe768
f method.func.0000e770 = 0xe770
f method.PointerEvent.get:distance = 0xe7a0
EXPECT_END
RUN

NAME=r2script-pp-scan-skipped
FILE=bins/android/mafia/libapp.so
CMDS=<<CMDS_END
L ../src/r2/core_flutter.dylib
L ../src/r2/core_flutter.so
r2flutter -R~:-3..0
CMDS_END
EXPECT=<<EXPECT_END
dr x27=`e anal.gp`
'f PP=x27
# PP offset scan skipped by default; use xrefs/analysis for pool-slot refs
EXPECT_END
RUN
