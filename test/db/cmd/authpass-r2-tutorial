NAME=r2-authpass-tls-flags
FILE=-
CMDS=<<EOF
!!sh -c 'p=../src/r2/core_flutter.so; [ -f "$p" ] || p=../src/r2/core_flutter.dylib; r2 -q -i "$p" -e scr.color=0 -e bin.relocs.apply=true -c "r2flutter -A" -c "f~onBadCertificateWrapper" -c "f~registerBadCertificateCallback" -c "f~secureHandshake" -c q bins/ios/AuthPass.app/Frameworks/App.framework/App 2>/dev/null | awk "/method\\._RawSecureSocket_.*\\._onBadCertificateWrapper_/ { print \"wrapper=\" \$1 } /method\\._SecureFilterImpl_.*\\.registerBadCertificateCallback$/ { print \"register=\" \$1 } /method\\._SecureFilterImpl_.*\\._registerBadCertificateCallback_/ { print \"register_impl=\" \$1 } /method\\._RawSecureSocket_.*\\._secureHandshake_/ { print \"handshake=\" \$1 }"'
EOF
EXPECT=<<EOF
wrapper=0x003199d4
register=0x003194ec
register_impl=0x0031954c
handshake=0x0031749c
EOF
RUN

