NAME=r2-authpass-qjs-bypass
FILE=-
CMDS=<<EOF
!!sh -c 't=$(mktemp /tmp/r2flutter-authpass.XXXXXX); cp bins/ios/AuthPass.app/Frameworks/App.framework/App "$t"; p=../src/r2/core_flutter.so; [ -f "$p" ] || p=../src/r2/core_flutter.dylib; r2 -q -w -i "$p" -e bin.relocs.apply=true -i ../scripts/dart_cert_bypass.qjs "$t" 2>/dev/null | awk -F= "/^target=/ { print \"target=\" \$2 } /^vaddr=/ { print \"vaddr=\" \$2 } /^after=/ { print \"after=\" \$2 } /^status=/ { print \"status=\" \$2 }"; r2 -q -n -a arm -b 64 -e scr.color=0 -c "s 0x3199d4" -c "p8 8" -c q "$t"; rm -f "$t"'
EOF
EXPECT=<<EOF
target=method._RawSecureSocket_14069316._onBadCertificateWrapper_14069316
vaddr=0x3199d4
after=c0820091c0035fd6
status=patched
c0820091c0035fd6
EOF
RUN
