NAME=header-fingerprint-unknown-hash
FILE=bins/android/first/libapp.so
CMDS=<<EOF
L ../src/r2/core_flutter.dylib
L ../src/r2/core_flutter.so
r2flutter -j -D ffffffffffffffffffffffffffffffff -H~{=}dart_version,version_source,tag_style
EOF
EXPECT=<<EOF
json.dart_version = "~3.12.0+ (fingerprint)";
json.version_source = "fingerprint";
json.tag_style = "OBJECT_HEADER";
EOF
RUN
